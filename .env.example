# Database (PostgreSQL via Neon — grab your URL from console.neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require"

# JWT Secret (change in production!)
JWT_SECRET="your-jwt-secret-change-me"

# Site URL (used for email links, invoice URLs, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin Credentials (change in production!)
ADMIN_EMAIL="admin@tourbooking.com"
ADMIN_PASSWORD="admin123"

# Payment Gateway: manual | midtrans
PAYMENT_GATEWAY="manual"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_MERCHANT_ID=""
# false = sandbox, true = production
MIDTRANS_IS_PRODUCTION="false"

# Email (SMTP — Gmail example; leave empty to log emails to console instead)
# Tip: when sending via Gmail SMTP, use your Gmail address as EMAIL_FROM to avoid spam filtering
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="your-email@gmail.com"

# WhatsApp Cloud API (Meta)
# Docs: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
# Admin number for new-order notifications (international format, no +; e.g. 6281234567890)
WHATSAPP_ADMIN_NUMBER=""
WHATSAPP_TEMPLATE_LANG="id"

# Cron secret — protects /api/cron/* endpoints (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="generate-a-random-string"

# Cloudinary — Image upload (gratis: https://cloudinary.com)
# Ambil dari Cloudinary Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Company Info (shown in footer, invoices, WhatsApp messages)
COMPANY_NAME="Jelajah Nusantara Tour"
COMPANY_PHONE="+6281234567890"
COMPANY_EMAIL="info@jelajahnusantara.com"
COMPANY_ADDRESS="Jl. Pariwisata No. 123, Jakarta Selatan"
